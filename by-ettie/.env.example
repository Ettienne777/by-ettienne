# Analytics settings
# Add your Google Analytics Measurement ID to enable tracking.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Email delivery settings
# Use SendGrid API if available, or SMTP credentials.
# If using SendGrid set SENDGRID_API_KEY and leave SMTP fields empty.
SENDGRID_API_KEY=
